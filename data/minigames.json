    "countdownSeconds": 2,
    "feedbackCorrectMs": 700,
    "feedbackWrongMs": 2400,
    "minRewardShare": 0.2,
    "quitEffortCap": 0.2,
    "warnSeconds": 10,
    "stars": [0.5, 0.75, 0.92],
    "bands": [
      { "min": 0.9, "key": "great", "lines": ["minigame.react.great.1", "minigame.react.great.2"] },
      { "min": 0.7, "key": "good", "lines": ["minigame.react.good.1", "minigame.react.good.2"] },
      { "min": 0.5, "key": "ok", "lines": ["minigame.react.ok.1", "minigame.react.ok.2"] },
      { "min": 0.25, "key": "low", "lines": ["minigame.react.low.1", "minigame.react.low.2"] },
      { "min": 0, "key": "zero", "lines": ["minigame.react.zero.1", "minigame.react.zero.2"] }
    ]
  },
